# WebVid environment
# Copy to .env or export these in your shell / run.sh / systemd / Railway etc.

# xAI Grok API key (optional but highly recommended for best script quality)
# Get one at https://console.x.ai/
# When set, the "✨ Improve with Grok AI" button in the UI will use it for
# much more creative, on-brand, scroll-stopping short video scripts.
XAI_API_KEY=your_xai_api_key_here

# Alternative name also supported
# GROK_API_KEY=your_xai_api_key_here

# Future: other secrets, render limits, etc.
# PORT=4819
